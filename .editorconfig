[*.astro]
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.css]
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.js]
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = false

[*.svg]
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[src/content/docs/**.md]
spelling_language = en-GB

[src/content/docs/**.mdx]
spelling_language = en-GB

[src/content/docs/nl/**.md]
spelling_language = nl

[src/content/docs/nl/**.mdx]
spelling_language = nl